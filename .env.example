# Claude  — https://console.anthropic.com/settings/keys   (--provider claude, the default)
ANTHROPIC_API_KEY=

# Gemini  — https://aistudio.google.com/apikey            (--provider gemini)
# Flash models work on the free tier; Pro models report quota `limit: 0` until
# billing is enabled on the Google Cloud project behind the key.
GEMINI_API_KEY=

# OpenAI  — https://platform.openai.com/api-keys            (--provider openai)
OPENAI_API_KEY=

# OpenRouter — https://openrouter.ai/settings/keys      (--provider openrouter)
# Uses free models (nvidia/nemotron-3.5-super-vl:free + fallbacks). Free tier: 20 req/min,
# 50 req/day, or 1000/day once $10 of credit has been bought.
OPENROUTER_API_KEY=
