# Claude  — https://console.anthropic.com/settings/keys   (--provider claude, the default)
ANTHROPIC_API_KEY=

# Gemini  — https://aistudio.google.com/apikey            (--provider gemini)
# Flash models work on the free tier; Pro models report quota `limit: 0` until
# billing is enabled on the Google Cloud project behind the key.
GEMINI_API_KEY=

# OpenAI  — https://platform.openai.com/api-keys            (--provider openai)
OPENAI_API_KEY=

# OpenRouter — https://openrouter.ai/settings/keys      (--provider openrouter)
# Uses free models (nvidia/nemotron-3.5-super-vl:free + fallbacks). Free tier: 20 req/min,
# 50 req/day, or 1000/day once $10 of credit has been bought.
OPENROUTER_API_KEY=

# Docling for IBM watsonx — optional OCR, OFF by default (the vision model was more accurate in
# scripts/benchmark_ocr.py). Set DOCLING_OCR_ENABLED=true to send every document to IBM for OCR.
# The URL and key are on the Workbench "API examples" page.
DOCLING_OCR_ENABLED=false
DOCLING_SERVICE_URL=
DOCLING_SERVICE_API_KEY=

# Web app history (every run's document and result, in SQLite). Default: data/history.db.
# Set to "off" to stop recording.
HISTORY_DB=

# Lets you delete runs from the History: open the app as http://<host>:8000/#admin, enter this key,
# and Delete buttons appear on each run. Leave blank and nobody can delete.
HISTORY_ADMIN_KEY=
